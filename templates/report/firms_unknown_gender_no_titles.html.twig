{% extends 'base.html.twig' %}

{% block pageheader %}
    <h1>{{ heading }}</h1>
    {% if firms|length > 0 %}
        Displaying {{ firms|length }} firms of {{ firms.getTotalItemCount }} total.
    {% else %}
        No firms found!
    {% endif %}
{% endblock %}

{% block body %}
    <p class="explanation">These firms have unknown gender and no attached titles.</p>

    {% if firms|length > 0 %}
        {% include 'firm/table.html.twig' with {'firms': firms} %}
    {% endif %}

{% endblock %}
